   "source": [
    "# ═══════════════════════════════════════════════════════════════\n",
    "# PHASE 5 — Ultra-Compact MTL-DNN (< 10K params)\n",
    "# ═══════════════════════════════════════════════════════════════\n",
    "\n",
    "class CompositeMTL(nn.Module):\n",
    "    \"\"\"Shared-encoder Multi-Task Learning DNN.\n",
    "    Architecture: 9 → 48 → 64 → 32 (shared) + 5 × (32→16→1) task heads\n",
    "    Trainable params: ~8,200 (vs original 76,417 — 89% reduction)\n",
    "    \"\"\"\n",
    "    def __init__(self, n_in=9, n_tasks=5, enc=(48,64,32), head_d=16, p=0.20):\n",
    "        super().__init__()\n",
    "        layers, d = [], n_in\n",
    "        for out in enc:\n",
    "            layers += [nn.Linear(d,out), nn.BatchNorm1d(out), nn.GELU(), nn.Dropout(p)]\n",
    "            d = out\n",
    "        self.encoder = nn.Sequential(*layers)\n",
    "        self.heads = nn.ModuleList([\n",
    "            nn.Sequential(nn.Linear(d,head_d), nn.GELU(),\n",
    "                          nn.Dropout(p*0.5), nn.Linear(head_d,1))\n",
    "            for _ in range(n_tasks)])\n",
    "    def forward(self, x):\n",
    "        h = self.encoder(x)\n",
    "        return torch.cat([hd(h) for hd in self.heads], dim=1)\n",
    "    def n_params(self):\n",
    "        return sum(p.numel() for p in self.parameters() if p.requires_grad)\n",
    "\n",
    "\n",
    "class UWLoss(nn.Module):\n",
    "    \"\"\"Kendall & Gal (2018) uncertainty-weighted multi-task loss.\"\"\"\n",
    "    def __init__(self, n):\n",
    "        super().__init__()\n",
    "        self.log_vars = nn.Parameter(torch.zeros(n))\n",
    "    def forward(self, pred, tgt):\n",
    "        total = sum(torch.exp(-self.log_vars[i]) * F.mse_loss(pred[:,i],tgt[:,i])\n",
    "                    + self.log_vars[i] for i in range(pred.shape[1]))\n",
    "        return total\n",
    "\n",
    "\n",
    "model = CompositeMTL().to(DEVICE)\n",
    "print(f'MTL-DNN: {model.n_params():,} trainable parameters')\n",
    "print(f'Reduction vs original: {(1-model.n_params()/76417)*100:.1f}%')"
   ]
  },

  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════\n",
    "# PHASE 6 — Training\n",
    "# ═══════════════════════════════════════════════════════════════\n",
    "\n",
    "def train(model, epochs=300, lr=3e-3, patience=35):\n",
    "    loss_fn  = UWLoss(len(TARGETS)).to(DEVICE)\n",
    "    opt      = torch.optim.AdamW(\n",
    "        list(model.parameters()) + list(loss_fn.parameters()),\n",
    "        lr=lr, weight_decay=1e-4)\n",
    "    sched    = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(opt, T_0=50, T_mult=2, eta_min=1e-5)\n",
    "    best_val, no_imp, best_state = np.inf, 0, None\n",
    "    hist = {'train':[], 'val':[]}\n",
    "\n",
    "    for ep in range(1, epochs+1):\n",
    "        model.train(); loss_fn.train()\n",
    "        tl = 0\n",
    "        for xb, yb in train_loader:\n",
    "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n",
    "            opt.zero_grad()\n",
    "            loss_fn(model(xb), yb).backward()\n",
    "            nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            opt.step()\n",
    "            tl += loss_fn(model(xb), yb).item()\n",
    "        sched.step()\n",
    "\n",
    "        model.eval(); loss_fn.eval()\n",
    "        with torch.no_grad():\n",
    "            vl = sum(loss_fn(model(xb.to(DEVICE)), yb.to(DEVICE)).item()\n",
    "                     for xb,yb in val_loader) / max(len(val_loader),1)\n",
    "        tl /= len(train_loader)\n",
    "        hist['train'].append(tl); hist['val'].append(vl)\n",
    "\n",
    "        if vl < best_val:\n",
    "            best_val, no_imp = vl, 0\n",
    "            best_state = {k: v.clone() for k,v in model.state_dict().items()}\n",
    "        else:\n",
    "            no_imp += 1\n",
    "        if ep % 50 == 0 or ep == 1:\n",
    "            print(f'Ep {ep:3d} | Train {tl:.4f} | Val {vl:.4f} | Patience {no_imp}/{patience}')\n",
    "        if no_imp >= patience:\n",
    "            print(f'Early stop at epoch {ep}')\n",
    "            break\n",
    "\n",
    "    model.load_state_dict(best_state)\n",
    "    return hist\n",
    "\n",
    "\n",
    "print('Training on real+augmented composite data...')\n",
    "t0 = time.time()\n",
    "history = train(model, epochs=400, lr=3e-3, patience=40)\n",
    "print(f'Done in {time.time()-t0:.1f}s')"
   ]
  },

