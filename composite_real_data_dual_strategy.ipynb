    "                  'R²':    r2_score(ya, yp),\n",
    "                  'MAPE%': np.mean(np.abs((ya-yp)/(np.abs(ya)+1e-8)))*100}\n",
    "    df_res = pd.DataFrame(res).T\n",
    "    print(f'\\n📊 {label}')\n",
    "    display(df_res.round(4))\n",
    "    return df_res, pred\n",
