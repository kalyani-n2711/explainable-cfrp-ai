    "# ═══════════════════════════════════════════════════════════════\n",
    "# PHASE 4 — Preprocessing (shared for both options)\n",
    "# We use Option 2 augmented data for training (more robust)\n",
    "# Option 1 real data is kept as HOLD-OUT validation set\n",
    "# ═══════════════════════════════════════════════════════════════\n",
    "\n",
    "df_train_src = df_aug.copy()       # Option 2: 2000 augmented rows for training\n",
    "df_holdout   = df_enc.copy()       # Option 1: 88 REAL rows — held out for final test\n",
    "\n",
    "X_all = df_train_src[FEATURES].values.astype(np.float32)\n",
    "Y_all = df_train_src[TARGETS].values.astype(np.float32)\n",
    "\n",
    "X_hold = df_holdout[FEATURES].values.astype(np.float32)\n",
    "Y_hold = df_holdout[TARGETS].values.astype(np.float32)\n",
    "\n",
    "# 70/15/15 split of augmented data\n",
    "X_tv, X_test, Y_tv, Y_test = train_test_split(X_all, Y_all, test_size=0.15, random_state=SEED)\n",
    "X_train, X_val, Y_train, Y_val = train_test_split(X_tv, Y_tv, test_size=0.1765, random_state=SEED)\n",
    "\n",
    "print(f'Train : {X_train.shape[0]} | Val: {X_val.shape[0]} | Test: {X_test.shape[0]}')\n",
    "print(f'Hold-out (100% real experimental data): {X_hold.shape[0]}')\n",
    "\n",
    "scaler_X  = StandardScaler().fit(X_train)\n",
    "scalers_Y = [StandardScaler().fit(Y_train[:,i:i+1]) for i in range(len(TARGETS))]\n",
    "\n",
    "def sx(X): return scaler_X.transform(X).astype(np.float32)\n",
    "def sy(Y): return np.hstack([scalers_Y[i].transform(Y[:,i:i+1]) for i in range(len(TARGETS))]).astype(np.float32)\n",
    "def isy(Ys): return np.hstack([scalers_Y[i].inverse_transform(Ys[:,i:i+1]) for i in range(len(TARGETS))])\n",
    "\n",
    "X_tr_s  = sx(X_train); Y_tr_s  = sy(Y_train)\n",
    "X_vl_s  = sx(X_val);   Y_vl_s  = sy(Y_val)\n",
    "X_te_s  = sx(X_test);  Y_te_s  = sy(Y_test)\n",
    "X_hd_s  = sx(X_hold);  # holdout — unscaled targets preserved in Y_hold\n",
    "\n",
    "BATCH = 128\n",
    "train_loader = DataLoader(TensorDataset(torch.from_numpy(X_tr_s), torch.from_numpy(Y_tr_s)),\n",
    "                          batch_size=BATCH, shuffle=True, drop_last=True)\n",
    "val_loader   = DataLoader(TensorDataset(torch.from_numpy(X_vl_s), torch.from_numpy(Y_vl_s)),\n",
    "                          batch_size=BATCH, shuffle=False)\n",
    "print('Preprocessing complete ✓')"
   ]
  },

  {
