    "    for _ in range(50):\n",
    "        fold_model.train()\n",
    "        for xb, yb in dl:\n",
    "            fold_opt.zero_grad()\n",
    "            fold_loss(fold_model(xb.to(DEVICE)), yb.to(DEVICE)).backward()\n",
    "            fold_opt.step()\n",
    "\n",
    "    fold_model.eval()\n",
    "    with torch.no_grad():\n",
    "        pf = fold_model(torch.from_numpy(xte).to(DEVICE)).cpu().numpy()\n",
    "    pf_orig = isy(pf)\n",
