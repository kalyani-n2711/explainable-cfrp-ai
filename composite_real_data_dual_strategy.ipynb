    "print('\\n📊 TIER 3 — 5-Fold CV on Real Data Only')\n",
    "kf = KFold(n_splits=5, shuffle=True, random_state=SEED)\n",
    "cv_r2s = {t: [] for t in TARGETS}\n",
    "\n",
    "for fold, (tr_idx, te_idx) in enumerate(kf.split(X_hold)):\n",
