    "    fold_model = CompositeMTL().to(DEVICE)\n",
    "    fold_model.load_state_dict(model.state_dict())  # warm start\n",
    "    fold_loss  = UWLoss(len(TARGETS)).to(DEVICE)\n",
    "    fold_opt   = torch.optim.AdamW(\n",
